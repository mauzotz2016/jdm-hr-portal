{
  "projectId": "YOUR_PROJECT_ID",
  "projectName": "JDM HR Portal",
  "databases": [
    {
      "$id": "hr_portal_db",
      "name": "HR Portal DB",
      "enabled": true
    }
  ],
  "collections": [
    {
      "$id": "employees",
      "$permissions": [
        "create(\"any\")",
        "read(\"any\")",
        "update(\"any\")",
        "delete(\"any\")"
      ],
      "databaseId": "hr_portal_db",
      "name": "Employees",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "size": 150
        },
        {
          "key": "email",
          "type": "string",
          "required": false,
          "size": 150
        },
        {
          "key": "phone",
          "type": "string",
          "required": false,
          "size": 50
        },
        {
          "key": "nida",
          "type": "string",
          "required": false,
          "size": 50
        },
        {
          "key": "role",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "branch",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "contractEnd",
          "type": "string",
          "required": false,
          "size": 50
        },
        {
          "key": "salary",
          "type": "integer",
          "required": true
        },
        {
          "key": "leaveBalance",
          "type": "integer",
          "required": false
        },
        {
          "key": "emergencyContact",
          "type": "string",
          "required": false,
          "size": 200
        },
        {
          "key": "status",
          "type": "string",
          "required": false,
          "size": 50,
          "default": "Active"
        }
      ],
      "indexes": []
    },
    {
      "$id": "staff_forms",
      "$permissions": [
        "create(\"any\")",
        "read(\"any\")",
        "update(\"any\")",
        "delete(\"any\")"
      ],
      "databaseId": "hr_portal_db",
      "name": "Staff Forms",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "size": 150
        },
        {
          "key": "email",
          "type": "string",
          "required": true,
          "size": 150
        },
        {
          "key": "branch",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "type",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "dates",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "notes",
          "type": "string",
          "required": false,
          "size": 300
        },
        {
          "key": "status",
          "type": "string",
          "required": false,
          "size": 50,
          "default": "Pending"
        }
      ],
      "indexes": []
    },
    {
      "$id": "leave_requests",
      "$permissions": [
        "create(\"any\")",
        "read(\"any\")",
        "update(\"any\")",
        "delete(\"any\")"
      ],
      "databaseId": "hr_portal_db",
      "name": "Leave Requests",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "emp",
          "type": "string",
          "required": true,
          "size": 150
        },
        {
          "key": "branch",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "type",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "dates",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "status",
          "type": "string",
          "required": false,
          "size": 50,
          "default": "Pending"
        }
      ],
      "indexes": []
    },
    {
      "$id": "appointments",
      "$permissions": [
        "create(\"any\")",
        "read(\"any\")",
        "update(\"any\")",
        "delete(\"any\")"
      ],
      "databaseId": "hr_portal_db",
      "name": "Appointments",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "type",
          "type": "string",
          "required": true,
          "size": 100
        },
        {
          "key": "person",
          "type": "string",
          "required": true,
          "size": 150
        },
        {
          "key": "subject",
          "type": "string",
          "required": true,
          "size": 200
        },
        {
          "key": "datetime",
          "type": "string",
          "required": true,
          "size": 50
        },
        {
          "key": "status",
          "type": "string",
          "required": false,
          "size": 50,
          "default": "Scheduled"
        }
      ],
      "indexes": []
    },
    {
      "$id": "external_portals",
      "$permissions": [
        "create(\"any\")",
        "read(\"any\")",
        "update(\"any\")",
        "delete(\"any\")"
      ],
      "databaseId": "hr_portal_db",
      "name": "External Portals",
      "enabled": true,
      "documentSecurity": false,
      "attributes": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "size": 150
        },
        {
          "key": "url",
          "type": "string",
          "required": true,
          "size": 300
        },
        {
          "key": "username",
          "type": "string",
          "required": false,
          "size": 150
        },
        {
          "key": "password",
          "type": "string",
          "required": false,
          "size": 150
        }
      ],
      "indexes": []
    }
  ]
}